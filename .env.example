DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
LLM_BASE_URL="https://YOUR_LLM_PROVIDER/v1"
LLM_API_KEY="replace-with-your-key"
LLM_REASONING_MODEL="cx/gpt-5.6-terra"
